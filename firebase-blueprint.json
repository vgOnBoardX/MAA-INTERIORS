{
  "entities": {
    "Contact": {
      "title": "Contact Submission",
      "description": "Quick message submission from potential clients",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "contacted"] }
      },
      "required": ["name", "message", "createdAt", "status"]
    },
    "Appointment": {
      "title": "Appointment Booking",
      "description": "Consultation booking request from potential clients",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "projectType": { "type": "string" },
        "budgetRange": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed"] }
      },
      "required": ["name", "email", "phone", "preferredDate", "createdAt", "status"]
    }
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "User-submitted inquiry messages"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "User-submitted design consultation appointments"
    }
  }
}
